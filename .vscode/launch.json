{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LapSim desktop app",
      "type": "debugpy",
      "request": "launch",
      "module": "lapsim.ui",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
